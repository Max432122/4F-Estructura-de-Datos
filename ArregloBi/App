public class App {
    public static void main(String[] args) throws Exception {

        int[][] arrTest = {
            {1},
            {6, 3, 1},
            {1, 2, 3, 4},
            {0, 5, 3, 0},
            {2, 5, 9},
            {2, 4, 8, 9, 10}
        };

        int[][] arrModificado = new int[arrTest.length][];

        for (int i = 0; i < arrTest.length; i++) {
            
            int[] filaOriginal = arrTest[i];
            
            int ultimoValor = filaOriginal[filaOriginal.length - 1];
            int valorAAgregar = ultimoValor + 1; 

            int[] nuevaFila = new int[filaOriginal.length + 1];

            for (int j = 0; j < filaOriginal.length; j++) {
                nuevaFila[j] = filaOriginal[j];
            }
            
            nuevaFila[nuevaFila.length - 1] = valorAAgregar;

            arrModificado[i] = nuevaFila;
        }

        System.out.println("Arreglo modificado:");
        for (int i = 0; i < arrModificado.length; i++) {
            System.out.print("{");
            for (int j = 0; j < arrModificado[i].length; j++) {
                System.out.print(arrModificado[i][j] + (j < arrModificado[i].length - 1 ? "," : ""));
            }
            System.out.println("}");
        }
    }
}