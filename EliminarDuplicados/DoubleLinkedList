public class DoubleLinkedList {

    Node head; 

    public void add(int data){
        Node newNode = new Node(data);
        if (head == null) {
            head = newNode;
            return;
        }

        Node current = head;
        while (current.next != null) {
            current = current.next;
        }
        current.next = newNode;
        newNode.prev = current;
    }

    public void printForward(){
        Node current = head;
        while (current != null) {
            System.out.println(current.data);
            current = current.next;
        }
        System.out.println("null");
    }

    public void printBackward(){
        Node current = head;
        if (current == null) {
            System.out.println("null");
            return;
        }

        while (current.next != null) {
            current = current.next;
        }
        
        while (current != null) {
            System.out.println(current.data);
            current = current.prev;
        }
        System.out.println("null");
    }

    public void eliminarDuplicados() {
        if (head == null || head.next == null) {
            return;
        }

        Node current = head;

        while (current != null) {
            
            Node nodoBuscador = current;

            while (nodoBuscador.next != null) {
                
                if (nodoBuscador.next.data == current.data) {
                    
                    Node nodoDuplicado = nodoBuscador.next; 
                    
                    nodoBuscador.next = nodoDuplicado.next; 

                    if (nodoBuscador.next != null) {
                        nodoBuscador.next.prev = nodoBuscador;
                    }
                    
                    System.out.println("Eliminado duplicado del valor: " + current.data);
                    
                } else {
                    nodoBuscador = nodoBuscador.next;
                }
            }
            
            current = current.next;
        }
        System.out.println("Proceso de eliminación de duplicados finalizado.");
    }
}